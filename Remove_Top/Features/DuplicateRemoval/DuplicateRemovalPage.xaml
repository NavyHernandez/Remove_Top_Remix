<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Remove_Top.Features.DuplicateRemoval.DuplicateRemovalPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Remove_Top.Features.DuplicateRemoval"
    xmlns:helpers="using:Remove_Top.Helpers"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <helpers:FileTypeIconConverter x:Key="FileTypeIcon" />
    </Page.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============================================================ -->
        <!-- HEADER: Branding + Título y descripción                     -->
        <!-- ============================================================ -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <Border CornerRadius="4" Padding="8,2" Background="#E74C3C" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <ic:FluentIcon Icon="MusicNote2" IconVariant="Regular" IconSize="Size12"
                                   Foreground="White" />
                    <TextBlock Text="Top Remix" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                </StackPanel>
            </Border>
            <TextBlock Text="Eliminación de Duplicados"
                       FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="Escanea una carpeta (incluye subcarpetas), detecta duplicados y luego envíalos a la Papelera. Se consideran EXACTOS los archivos con el mismo contenido (hash), el mismo nombre de canción cambiando solo el formato (mayúsculas, guiones, espacios, acentos) o nombres que difieren en una sola letra (falta ortográfica); los 'posibles' se verifican por duración de audio para descartar falsos positivos."
                       FontSize="14"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Margin="0,4,0,0" />
        </StackPanel>

        <!-- ============================================================ -->
        <!-- CONTENT                                                      -->
        <!-- ============================================================ -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="16">

                <!-- ==================================================== -->
                <!-- AVISO: Límite de la versión gratuita                 -->
                <!-- ==================================================== -->
                <InfoBar x:Name="LimitInfoBar"
                         Severity="Informational"
                         IsOpen="True"
                         IsClosable="False"
                         Title="Versión gratuita: hasta 1.000 archivos"
                         Message="El escaneo es recursivo e incluye las subcarpetas. Si la carpeta tiene más de 1.000 archivos, se analizan los primeros 1.000." />

                <!-- ==================================================== -->
                <!-- SECCIÓN: Selección de la carpeta de origen           -->
                <!-- ==================================================== -->
                <Border BorderBrush="{ThemeResource ControlElevationBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16"
                        Background="{ThemeResource LayerFillColorDefaultBrush}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Carpeta de origen"
                                   FontSize="16" FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBox x:Name="FolderPathBox"
                                     PlaceholderText="Selecciona una carpeta; se incluirán sus subcarpetas..."
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     CornerRadius="4" />
                            <Button Grid.Column="1"
                                    x:Name="BrowseButton"
                                    Content="Examinar..."
                                    Click="BrowseButton_Click"
                                    CornerRadius="4"
                                    Background="Transparent"
                                    BorderBrush="#E74C3C"
                                    Foreground="#E74C3C"
                                    BorderThickness="1.5" />
                        </Grid>
                        <TextBlock FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap">
                            <Run Text="Ingresa a " />                            
                            <Run FontWeight="Bold" Text="www.top-remix.com" />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- ==================================================== -->
                <!-- SECCIÓN: Escaneo (loader + indicador de estado)      -->
                <!-- ==================================================== -->
                <Border BorderBrush="{ThemeResource ControlElevationBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16"
                        Background="{ThemeResource LayerFillColorDefaultBrush}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Escaneo"
                                   FontSize="16" FontWeight="SemiBold" />
                        <Button x:Name="ScanButton"
                                FontSize="14" FontWeight="SemiBold"
                                Height="40"
                                HorizontalAlignment="Stretch"
                                CornerRadius="6"
                                Click="ScanButton_Click"
                                IsEnabled="False"
                                Background="#E67E22"
                                Foreground="White"
                                BorderThickness="0" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <ProgressRing x:Name="ScanLoader"
                                          Width="24" Height="24"
                                          IsActive="False"
                                          Visibility="Collapsed"
                                          VerticalAlignment="Center" />
                            <TextBlock x:Name="ScanStatusText"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ==================================================== -->
                <!-- SECCIÓN: Resultados en pestañas numeradas            -->
                <!-- ==================================================== -->
                <Border x:Name="ResultsSection"
                        BorderBrush="{ThemeResource ControlElevationBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        Visibility="Collapsed">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Resultados"
                                       FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1"
                                       x:Name="SummaryText"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <TabView x:Name="ResultsTabView"
                                 TabWidthMode="SizeToContent"
                                 IsAddTabButtonVisible="False"
                                 SelectionChanged="ResultsTabView_SelectionChanged">
                            <TabViewItem x:Name="ExactTab" IsClosable="False">
                                <TabViewItem.Header>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <ic:FluentIcon Icon="CheckmarkCircle" IconVariant="Regular" IconSize="Size16"
                                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                       VerticalAlignment="Center" />
                                        <TextBlock x:Name="ExactTabHeader" Text="· Duplicados exactos" VerticalAlignment="Center"
                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    </StackPanel>
                                </TabViewItem.Header>
                                <ListView x:Name="ExactListView" SelectionMode="None" MaxHeight="260">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto"
                                                  ColumnSpacing="8" Margin="0,2">
                                                <CheckBox IsChecked="{Binding IsMarkedForDeletion, Mode=TwoWay}"
                                                          VerticalAlignment="Center" />
                                                <ic:FluentIcon Grid.Column="1"
                                                               Icon="{Binding FilePath, Converter={StaticResource FileTypeIcon}}"
                                                               IconVariant="Regular" IconSize="Size16"
                                                               VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding FileName}"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding FolderPath}"
                                                               FontSize="11"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="3"
                                                           Text="{Binding SizeDisplay}"
                                                           FontSize="12"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           VerticalAlignment="Center" />
                                                <Border Grid.Column="4"
                                                        CornerRadius="10"
                                                        Padding="8,2"
                                                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding RepeatDisplay}"
                                                               FontSize="12" FontWeight="SemiBold"
                                                               Foreground="#E74C3C" />
                                                </Border>
                                                <Border Grid.Column="5"
                                                        CornerRadius="10"
                                                        Padding="8,2"
                                                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                                                        VerticalAlignment="Center">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding MatchDisplay}"
                                                                   FontSize="12" FontWeight="SemiBold"
                                                                   Foreground="#E74C3C" />
                                                        <TextBlock Text="{Binding MatchDetailDisplay}"
                                                                   FontSize="11"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </TabViewItem>

                            <TabViewItem x:Name="PossibleTab" IsClosable="False">
                                <TabViewItem.Header>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <ic:FluentIcon Icon="Warning" IconVariant="Regular" IconSize="Size16"
                                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                       VerticalAlignment="Center" />
                                        <TextBlock x:Name="PossibleTabHeader" Text="· Posibles" VerticalAlignment="Center"
                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    </StackPanel>
                                </TabViewItem.Header>
                                <ListView x:Name="PossibleListView" SelectionMode="None" MaxHeight="260">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto"
                                                  ColumnSpacing="8" Margin="0,2">
                                                <CheckBox IsChecked="{Binding IsMarkedForDeletion, Mode=TwoWay}"
                                                          VerticalAlignment="Center" />
                                                <ic:FluentIcon Grid.Column="1"
                                                               Icon="{Binding FilePath, Converter={StaticResource FileTypeIcon}}"
                                                               IconVariant="Regular" IconSize="Size16"
                                                               VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding FileName}"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding FolderPath}"
                                                               FontSize="11"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="3"
                                                           Text="{Binding SizeDisplay}"
                                                           FontSize="12"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           VerticalAlignment="Center" />
                                                <Border Grid.Column="4"
                                                        CornerRadius="10"
                                                        Padding="8,2"
                                                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding RepeatDisplay}"
                                                               FontSize="12" FontWeight="SemiBold"
                                                               Foreground="#E74C3C" />
                                                </Border>
                                                <Border Grid.Column="5"
                                                        CornerRadius="10"
                                                        Padding="8,2"
                                                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                                                        VerticalAlignment="Center">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding MatchDisplay}"
                                                                   FontSize="12"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        <TextBlock Text="{Binding MatchDetailDisplay}"
                                                                   FontSize="11"
                                                                   Foreground="#E67E22"
                                                                   Opacity="0.9" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </TabViewItem>

                            <TabViewItem x:Name="DamagedTab" IsClosable="False">
                                <TabViewItem.Header>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <ic:FluentIcon Icon="ErrorCircle" IconVariant="Regular" IconSize="Size16"
                                                       Foreground="#C0392B" VerticalAlignment="Center" />
                                        <TextBlock x:Name="DamagedTabHeader" Text="· Archivos dañados" VerticalAlignment="Center"
                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    </StackPanel>
                                </TabViewItem.Header>
                                <ListView x:Name="DamagedListView" SelectionMode="None" MaxHeight="260">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto"
                                                  ColumnSpacing="8" Margin="0,2">
                                                <CheckBox IsChecked="{Binding IsMarkedForDeletion, Mode=TwoWay}"
                                                          VerticalAlignment="Center" />
                                                <ic:FluentIcon Grid.Column="1"
                                                               Icon="ErrorCircle" IconVariant="Regular" IconSize="Size16"
                                                               Foreground="#C0392B"
                                                               VerticalAlignment="Center" />
                                                <ic:FluentIcon Grid.Column="2"
                                                               Icon="{Binding FilePath, Converter={StaticResource FileTypeIcon}}"
                                                               IconVariant="Regular" IconSize="Size16"
                                                               VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding FileName}"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding FolderPath}"
                                                               FontSize="11"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="4"
                                                           Text="{Binding SizeDisplay}"
                                                           FontSize="12"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           VerticalAlignment="Center" />
                                                <Border Grid.Column="5"
                                                        CornerRadius="10"
                                                        Padding="8,2"
                                                        Background="#C0392B"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding MatchDisplay}"
                                                               FontSize="12" FontWeight="SemiBold"
                                                               Foreground="White" />
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </TabViewItem>
                        </TabView>
                    </StackPanel>
                </Border>

                <!-- ==================================================== -->
                <!-- SECCIÓN: Acciones (visible al cargar una carpeta)    -->
                <!-- ==================================================== -->
                <Border x:Name="ActionsSection"
                        Visibility="Collapsed"
                        BorderBrush="{ThemeResource ControlElevationBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14,10"
                        Background="{ThemeResource LayerFillColorDefaultBrush}">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="SelectionCountText"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                        <Grid ColumnDefinitions="Auto,Auto,Auto,Auto"
                              ColumnSpacing="8"
                              HorizontalAlignment="Right">
                            <Button x:Name="SelectAllButton"
                                    Content="Borrar todos"
                                    Click="SelectAllButton_Click"
                                    CornerRadius="4"
                                    IsEnabled="False"
                                    Background="Transparent"
                                    BorderBrush="#E74C3C"
                                    Foreground="#E74C3C"
                                    BorderThickness="1.5" />
                            <Button Grid.Column="1"
                                    x:Name="DeleteButton"
                                    Content="Eliminar seleccionados"
                                    Click="DeleteButton_Click"
                                    CornerRadius="4"
                                    IsEnabled="False"
                                    Background="#E67E22"
                                    Foreground="White"
                                    BorderThickness="0" />
                            <Button Grid.Column="2"
                                    x:Name="DeletePermanentButton"
                                    Content="Eliminar definitivamente"
                                    Click="DeletePermanentButton_Click"
                                    CornerRadius="4"
                                    IsEnabled="False"
                                    Background="#C0392B"
                                    Foreground="White"
                                    BorderThickness="0" />
                            <Button Grid.Column="3"
                                    x:Name="CancelButton"
                                    Click="CancelButton_Click"
                                    CornerRadius="4"
                                    IsEnabled="False"
                                    Background="Transparent"
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    BorderThickness="1.5" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ==================================================== -->
                <!-- SECCIÓN: Progreso durante la eliminación             -->
                <!-- ==================================================== -->
                <Border x:Name="ProgressSection"
                        BorderBrush="{ThemeResource ControlElevationBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        Visibility="Collapsed">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Eliminando..."
                                   FontSize="16" FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="*,Auto">
                            <ProgressBar x:Name="DeleteProgressBar"
                                         Value="0"
                                         ShowPaused="False"
                                         CornerRadius="2" />
                            <TextBlock Grid.Column="1"
                                       x:Name="DeleteProgressCountText"
                                       FontSize="13"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock x:Name="DeleteProgressText"
                                   FontSize="13"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- ==================================================== -->
                <!-- SECCIÓN: Resultados de la eliminación                -->
                <!-- ==================================================== -->
                <Border x:Name="DeletionResultsSection"
                        BorderBrush="{ThemeResource ControlElevationBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        Visibility="Collapsed">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Resultado de la eliminación"
                                       FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1"
                                       x:Name="DeletionSummaryText"
                                       FontSize="13"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                        <ListView x:Name="DeletionResultsListView"
                                  SelectionMode="None"
                                  MaxHeight="320">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="Auto,*,Auto"
                                          Margin="0,2"
                                          ColumnSpacing="8">
                                        <ic:FluentIcon Icon="{Binding StatusIcon}"
                                                       IconVariant="Regular" IconSize="Size16"
                                                       VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FileName}"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Message}"
                                                       FontSize="12"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <Button x:Name="RestartButton"
                                Content="Iniciar de nuevo"
                                Click="RestartButton_Click"
                                CornerRadius="4"
                                HorizontalAlignment="Center"
                                MinWidth="220"
                                Margin="0,4,0,0"
                                Visibility="Collapsed"
                                Background="Transparent"
                                BorderBrush="#E67E22"
                                Foreground="#E67E22"
                                BorderThickness="1.5" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
