<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Remove_Top.Features.BatchRename.BatchRenamePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Remove_Top.Features.BatchRename"
    xmlns:helpers="using:Remove_Top.Helpers"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <helpers:FileTypeIconConverter x:Key="FileTypeIcon" />
    </Page.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============================================================ -->
        <!-- HEADER: Branding + Título                                   -->
        <!-- ============================================================ -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <Border CornerRadius="4" Padding="8,2" Background="#70AD47" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <ic:FluentIcon Icon="MusicNote2" IconVariant="Regular" IconSize="Size12"
                                   Foreground="White" />
                    <TextBlock Text="Top Remix" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                </StackPanel>
            </Border>
            <TextBlock Text="Renombrado Masivo"
                       FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="Elimina texto específico del nombre de archivos. Soporta audio, video, imagen y documentos."
                       FontSize="14"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Margin="0,4,0,0" />
        </StackPanel>

        <!-- ============================================================ -->
        <!-- CONTENT                                                      -->
        <!-- ============================================================ -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="16">

                <!-- ==================================================== -->
                <!-- SECCIÓN: Carpeta de origen                           -->
                <!-- ==================================================== -->
                <Border BorderBrush="{ThemeResource ControlElevationBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16"
                        Background="{ThemeResource LayerFillColorDefaultBrush}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Carpeta de origen"
                                   FontSize="16" FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBox x:Name="FolderPathBox"
                                     PlaceholderText="Selecciona una carpeta con archivos..."
                                     IsReadOnly="True"
                                     CornerRadius="4" />
                            <Button Grid.Column="1"
                                    x:Name="BrowseButton"
                                    Content="Examinar..."
                                    Click="BrowseButton_Click"
                                    CornerRadius="4"
                                    Background="Transparent"
                                    BorderBrush="#70AD47"
                                    Foreground="#70AD47"
                                    BorderThickness="1.5" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ==================================================== -->
                <!-- SECCIÓN: Patrones a eliminar (chips con X)           -->
                <!-- ==================================================== -->
                <Border BorderBrush="{ThemeResource ControlElevationBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16"
                        Background="{ThemeResource LayerFillColorDefaultBrush}">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Patrones a eliminar"
                                       FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1"
                                       x:Name="PatternCountText"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <!-- Input + Add button -->
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBox x:Name="PatternInput"
                                     PlaceholderText="Ej: Dj Pepito, - Cover, (Official Video)..."
                                     TextChanged="PatternInput_TextChanged"
                                     KeyDown="PatternInput_KeyDown"
                                     CornerRadius="4" />
                            <Button Grid.Column="1"
                                    x:Name="AddPatternButton"
                                    Content="+ Agregar"
                                    Click="AddPatternButton_Click"
                                    CornerRadius="4"
                                    IsEnabled="False"
                                    Background="Transparent"
                                    BorderBrush="#70AD47"
                                    Foreground="#70AD47"
                                    BorderThickness="1.5" />
                        </Grid>

                        <!-- Pattern chips -->
                        <Border x:Name="PatternsContainer"
                                Padding="8"
                                CornerRadius="6"
                                BorderBrush="{ThemeResource ControlElevationBorderBrush}"
                                BorderThickness="1"
                                Visibility="Collapsed">
                            <ItemsControl x:Name="PatternsItemsControl">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ItemsWrapGrid Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="14"
                                                Padding="10,4,4,4"
                                                Margin="0,0,8,8"
                                                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                                BorderThickness="1"
                                                Background="{ThemeResource ControlFillColorDefaultBrush}">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                                                <TextBlock Text="{Binding Text}"
                                                           MaxWidth="240"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"
                                                           FontSize="13" />
                                                <Button Grid.Column="1"
                                                        Content="✕"
                                                        FontSize="11"
                                                        Width="20"
                                                        Height="20"
                                                        Padding="0"
                                                        CornerRadius="10"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Click="RemovePattern_Click"
                                                        Tag="{Binding Text}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border CornerRadius="4" Padding="8,2" Background="#70AD47">
                                <TextBlock Text="Versión Gratuita" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                            </Border>
                            <TextBlock FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center">
                                <Run Text="Máximo 20 patrones. La búsqueda no distingue mayúsculas/minúsculas." />
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ==================================================== -->
                <!-- SECCIÓN: Mejora de patrones con IA                    -->
                <!-- ==================================================== -->
                <Border x:Name="AiSection"
                        BorderBrush="{ThemeResource ControlElevationBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        Visibility="Collapsed">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Mejorar patrones con IA"
                                   FontSize="16" FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <TextBlock Text="Proveedor:"
                                       FontSize="13"
                                       VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1"
                                      x:Name="ProviderComboBox"
                                      HorizontalAlignment="Stretch"
                                      CornerRadius="4"
                                      SelectionChanged="ProviderComboBox_SelectionChanged">
                                <ComboBoxItem x:Name="ProviderMockItem"
                                              Content="Prueba local (Mock)"
                                              Tag="mock" />
                                <ComboBoxItem x:Name="ProviderGroqItem"
                                              Content="Groq (API real)"
                                              Tag="groq" />
                            </ComboBox>
                            <PasswordBox Grid.Column="2"
                                         x:Name="ApiKeyBox"
                                         PlaceholderText="API Key de Groq"
                                         Width="220"
                                         CornerRadius="4"
                                         IsEnabled="False"
                                         PasswordChanged="ApiKeyBox_PasswordChanged" />
                        </Grid>
                        <TextBlock x:Name="AiStatusText"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                        <ProgressBar x:Name="AiProgressBar"
                                     IsIndeterminate="True"
                                     CornerRadius="2"
                                     Visibility="Collapsed" />
                        <Button x:Name="SuggestPatternsButton"
                                FontSize="14" FontWeight="SemiBold"
                                Height="40"
                                HorizontalAlignment="Stretch"
                                CornerRadius="6"
                                Click="SuggestPatternsButton_Click"
                                IsEnabled="False"
                                Background="Transparent"
                                BorderBrush="#70AD47"
                                Foreground="#70AD47"
                                BorderThickness="1.5" />
                    </StackPanel>
                </Border>

                <!-- ==================================================== -->
                <!-- SECCIÓN: Sugerencias de patrones con IA               -->
                <!-- ==================================================== -->
                <Border x:Name="PatternSuggestionsSection"
                        BorderBrush="{ThemeResource ControlElevationBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        Visibility="Collapsed">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <CheckBox x:Name="ApproveAllCheckBox"
                                      Content="Aprobar todos"
                                      Click="ApproveAllCheckBox_Click"
                                      VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       x:Name="ApprovedCountText"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="2"
                                    x:Name="ApplyApprovedButton"
                                    Content="Agregar aprobados"
                                    Click="ApplyApprovedButton_Click"
                                    CornerRadius="4"
                                    IsEnabled="False"
                                    Background="Transparent"
                                    BorderBrush="#70AD47"
                                    Foreground="#70AD47"
                                    BorderThickness="1.5" />
                        </Grid>
                        <ListView x:Name="PatternSuggestionsListView"
                                  SelectionMode="None"
                                  MaxHeight="240">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="Auto,Auto,*,Auto"
                                          ColumnSpacing="8"
                                          Margin="0,2">
                                        <CheckBox IsChecked="{Binding IsApproved, Mode=TwoWay}"
                                                  VerticalAlignment="Center" />
                                        <ic:FluentIcon Grid.Column="1"
                                                       Icon="{Binding StatusIcon}"
                                                       IconVariant="Regular" IconSize="Size16"
                                                       VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Text}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis" />
                                        <Border Grid.Column="3"
                                                CornerRadius="10"
                                                Padding="8,2"
                                                Background="{ThemeResource ControlFillColorDefaultBrush}"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding MatchesDisplay}"
                                                       FontSize="12"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <!-- ==================================================== -->
                <!-- SECCIÓN: Vista previa de archivos afectados          -->
                <!-- ==================================================== -->
                <Border x:Name="PreviewSection"
                        BorderBrush="{ThemeResource ControlElevationBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        Visibility="Collapsed">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Archivos afectados"
                                       FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1"
                                       x:Name="AffectedCountText"
                                       FontSize="13"
                                       FontWeight="Medium"
                                       Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <ListView x:Name="PreviewListView"
                                  SelectionMode="None"
                                  MaxHeight="180">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8"
                                          Margin="0,2">
                                        <ic:FluentIcon Icon="{Binding Converter={StaticResource FileTypeIcon}}"
                                                       IconVariant="Regular" IconSize="Size16"
                                                       VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding}"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <!-- ==================================================== -->
                <!-- BOTÓN DE ACCIÓN                                       -->
                <!-- ==================================================== -->
                <Button x:Name="StartButton"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Height="44"
                        HorizontalAlignment="Stretch"
                        CornerRadius="6"
                        Click="StartButton_Click"
                        IsEnabled="False"
                        Background="#70AD47" Foreground="White" BorderThickness="0" />

                <!-- ==================================================== -->
                <!-- SECCIÓN: Progreso                                     -->
                <!-- ==================================================== -->
                <Border x:Name="ProgressSection"
                        BorderBrush="{ThemeResource ControlElevationBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        Visibility="Collapsed">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Renombrando..."
                                       FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1"
                                       x:Name="ProgressCountText"
                                       FontSize="13"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <ProgressBar x:Name="ProgressBar"
                                     Value="0"
                                     ShowPaused="False"
                                     CornerRadius="2" />
                        <TextBlock x:Name="ProgressText"
                                   FontSize="13"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- ==================================================== -->
                <!-- SECCIÓN: Resultados                                   -->
                <!-- ==================================================== -->
                <Border x:Name="ResultsSection"
                        BorderBrush="{ThemeResource ControlElevationBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        Visibility="Collapsed">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                            <TextBlock Text="Resultados"
                                       FontSize="16" FontWeight="SemiBold" />
                            <Border Grid.Column="1"
                                    x:Name="CompleteBadge"
                                    CornerRadius="4"
                                    Padding="8,2"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    Visibility="Collapsed">
                                <TextBlock x:Name="CompleteText"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="White" />
                            </Border>
                            <TextBlock Grid.Column="2"
                                       x:Name="SummaryText"
                                       FontSize="13"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                        <ListView x:Name="ResultsListView"
                                  SelectionMode="None"
                                  MaxHeight="320">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="Auto,*,Auto"
                                          Margin="0,2"
                                          ColumnSpacing="8">
                                        <ic:FluentIcon Icon="{Binding StatusIcon}"
                                                       IconVariant="Regular" IconSize="Size16"
                                                       VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding OriginalName}"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Message}"
                                                       FontSize="12"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding NewName}"
                                                   FontSize="12"
                                                   FontWeight="Medium"
                                                   Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        <Button x:Name="RestartButton"
                                Content="Iniciar de nuevo"
                                Click="RestartButton_Click"
                                CornerRadius="4"
                                HorizontalAlignment="Center"
                                MinWidth="220"
                                Margin="0,4,0,0"
                                Visibility="Collapsed"
                                Background="Transparent"
                                BorderBrush="#70AD47"
                                Foreground="#70AD47"
                                BorderThickness="1.5" />
                        </StackPanel>
                    </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
