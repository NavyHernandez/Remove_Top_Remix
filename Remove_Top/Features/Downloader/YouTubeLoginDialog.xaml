<ContentDialog
    x:Class="Remove_Top.Features.Downloader.YouTubeLoginDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Conectar cuenta de YouTube"
    PrimaryButtonText="Cerrar"
    DefaultButton="Primary"
    MaxWidth="560">

    <StackPanel Spacing="8" MinWidth="480">
        <TextBlock x:Name="NoteText"
                   FontSize="11"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   TextWrapping="Wrap" />
        <Border BorderBrush="{ThemeResource ControlElevationBorderBrush}"
                BorderThickness="1" CornerRadius="6">
            <WebView2 x:Name="LoginWeb" Height="520" />
        </Border>
        <TextBlock x:Name="StatusText"
                   FontSize="12"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </StackPanel>
</ContentDialog>
