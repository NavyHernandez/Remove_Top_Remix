<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Remove_Top.Features.Downloader.DownloaderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Remove_Top.Features.Downloader"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Unloaded="Page_Unloaded">

    <!-- Color de acento de la funcionalidad (azul marino), centralizado para
         poder cambiarlo en un solo lugar. El "Soft" es el mismo con alfa 20%
         y el "Light" es la variante para el hover.
         Los botones de acción son sólidos (fondo marino, letras blancas) y el
         hover unificado (fondo claro, borde y letras blancas) se aplica a todos
         los botones de la página mediante estos recursos del tema. -->
    <Page.Resources>
        <SolidColorBrush x:Key="DownloaderAccentBrush" Color="#19376D" />
        <SolidColorBrush x:Key="DownloaderAccentSoftBrush" Color="#3319376D" />
        <SolidColorBrush x:Key="DownloaderAccentLightBrush" Color="#2A4D85" />
        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#2A4D85" />
        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="White" />
        <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White" />
        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#2A4D85" />
        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="White" />
        <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White" />

        <!-- Estilo compacto propio para los checks de opciones (mismo patrón
             que Convertir Formatos): caja de 16 px con el azul marino de la
             funcionalidad. La plantilla de WinUI fija 20 px y no responde a
             FontSize. Solo esta página. -->
        <Style x:Key="DownloaderCheckStyle" TargetType="CheckBox">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="10,4,0,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid x:Name="RootGrid" Background="Transparent">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CheckBoxBorder" Storyboard.TargetProperty="Opacity">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="0.85" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CheckBoxBorder" Storyboard.TargetProperty="Opacity">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="0.7" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Opacity">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="0.5" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualState x:Name="Unchecked" />
                                    <VisualState x:Name="Checked">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CheckBoxBorder" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#19376D" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CheckBoxBorder" Storyboard.TargetProperty="BorderBrush">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#19376D" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CheckGlyph" Storyboard.TargetProperty="Visibility">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="Visible" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Indeterminate">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CheckBoxBorder" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#19376D" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="IndeterminateGlyph" Storyboard.TargetProperty="Visibility">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="Visible" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid x:Name="CheckBoxGrid" Width="16" Height="16" VerticalAlignment="Center">
                                <Border x:Name="CheckBoxBorder"
                                        Background="Transparent"
                                        BorderBrush="#19376D"
                                        BorderThickness="1.5"
                                        CornerRadius="3" />
                                <FontIcon x:Name="CheckGlyph"
                                          FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                          Glyph="&#xE73E;"
                                          FontSize="11"
                                          Foreground="White"
                                          Visibility="Collapsed"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                                <Border x:Name="IndeterminateGlyph"
                                        Background="White"
                                        Width="6" Height="6"
                                        CornerRadius="1"
                                        Visibility="Collapsed" />
                            </Grid>
                            <ContentPresenter Grid.Column="1"
                                              Content="{TemplateBinding Content}"
                                              FontSize="{TemplateBinding FontSize}"
                                              Foreground="{TemplateBinding Foreground}"
                                              Margin="10,3,0,3"
                                              VerticalAlignment="Center" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Entrada del popup de error: la tarjeta sube con rebote y el velo aparece con fundido. -->
        <Storyboard x:Name="ErrorPopupShowStoryboard">
            <DoubleAnimation Storyboard.TargetName="ErrorPopupCard"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                             From="160" To="0" Duration="0:0:0.7">
                <DoubleAnimation.EasingFunction>
                    <BounceEase Bounces="3" Bounciness="2" EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="ErrorPopupOverlay"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.25" />
        </Storyboard>
    </Page.Resources>

    <!-- Zona de arrastre: permite soltar un archivo .txt con enlaces. -->
    <Grid Background="Transparent"
          AllowDrop="True"
          DragEnter="Root_DragEnter"
          DragOver="Root_DragOver"
          DragLeave="Root_DragLeave"
          Drop="Root_Drop">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <Border Style="{StaticResource BrandBadgeBorderStyle}" Background="{StaticResource DownloaderAccentBrush}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
                    <ic:FluentIcon Icon="ArrowDownload" IconVariant="Regular" IconSize="Size12"
                                   Foreground="White" />
                    <TextBlock x:Name="BrandText" Text="" Style="{StaticResource BrandTextStyle}" />
                </StackPanel>
            </Border>
            <TextBlock x:Name="PageTitleText"
                       Text=""
                       FontSize="28" FontWeight="SemiBold" />
            <TextBlock x:Name="PageSubtitleText"
                       Text=""
                       FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Margin="0,4,0,0"
                       TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="16">

                <!-- Aviso contextual: oculto por defecto, solo aparece ante
                     advertencias/errores (SetInfo). En estado normal la página
                     queda limpia, sin tarjeta informativa permanente. -->
                <InfoBar x:Name="InfoBar"
                         Severity="Informational"
                         IsOpen="True"
                         IsClosable="False"
                         Visibility="Collapsed"
                         Title=""
                         Message="" />

                <!-- Opciones de procesado en la misma fila. -->
                <StackPanel Orientation="Horizontal" Spacing="24">
                    <!-- Normalizar al descargar: la única opción de procesado. -->
                    <CheckBox x:Name="MasterizeCheckBox"
                              Style="{StaticResource DownloaderCheckStyle}"
                              Content="Normalizar al descargar (masterización Hard Limiter)"
                              FontSize="12"
                              IsChecked="True" />

                    <!-- Conservar el WAV descargado además del normalizado (apagado por defecto). -->
                    <CheckBox x:Name="KeepOriginalCheckBox"
                              Style="{StaticResource DownloaderCheckStyle}"
                              Content="Conservar archivo original descargado"
                              FontSize="11"
                              IsChecked="False" />
                </StackPanel>

                <!-- CUENTA DE YOUTUBE (opcional): desbloquea videos con restricción. -->
                <Border x:Name="AccountSection"
                        BorderBrush="{ThemeResource ControlElevationBorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16"
                        Background="{ThemeResource LayerFillColorDefaultBrush}">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock x:Name="AccountTitleText"
                                       FontSize="16" FontWeight="SemiBold" />
                            <Button Grid.Column="1" x:Name="AccountButton"
                                    Click="AccountButton_Click"
                                    CornerRadius="4"
                                    Background="{StaticResource DownloaderAccentBrush}"
                                    Foreground="White"
                                    BorderBrush="{StaticResource DownloaderAccentBrush}"
                                    BorderThickness="1" />
                        </Grid>
                        <TextBlock x:Name="AccountStatusText"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="AccountNoteText"
                                   FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- ENLACES -->
                <Border BorderBrush="{ThemeResource ControlElevationBorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16"
                        Background="{ThemeResource LayerFillColorDefaultBrush}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Enlaces de YouTube" FontSize="16" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border CornerRadius="4" Padding="8,2" Background="#70AD47">
                                <TextBlock x:Name="DownloaderFreeBadge"
                                           Text=""
                                           FontSize="11" FontWeight="SemiBold" Foreground="White" />
                            </Border>
                            <TextBlock x:Name="DownloaderLimitText"
                                       FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBox x:Name="UrlBox"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 Height="96"
                                 CornerRadius="4"
                                 PlaceholderText="Pega uno o más enlaces (uno por línea)..."
                                 TextChanged="UrlBox_TextChanged" />
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <Button x:Name="AddButton" Click="AddButton_Click"
                                    CornerRadius="4"
                                    Background="{StaticResource DownloaderAccentBrush}"
                                    Foreground="White"
                                    BorderBrush="{StaticResource DownloaderAccentBrush}"
                                    BorderThickness="1" />
                            <TextBlock Grid.Column="1"
                                       Text="…o arrastra aquí un archivo .txt con enlaces."
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- CARPETA DESTINO -->
                <Border BorderBrush="{ThemeResource ControlElevationBorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16"
                        Background="{ThemeResource LayerFillColorDefaultBrush}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Carpeta de destino" FontSize="16" FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBox x:Name="FolderPathBox"
                                     PlaceholderText="Selecciona dónde guardar los archivos..."
                                     IsReadOnly="True"
                                     CornerRadius="4" />
                            <Button Grid.Column="1" x:Name="BrowseButton" Click="BrowseButton_Click"
                                    CornerRadius="4"
                                    Background="{StaticResource DownloaderAccentBrush}"
                                    Foreground="White"
                                    BorderBrush="{StaticResource DownloaderAccentBrush}"
                                    BorderThickness="1" />
                        </Grid>
                        <TextBlock FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Text="Los audios descargados se guardan en esta carpeta; los normalizados en la subcarpeta OneDj_Normalized." />
                    </StackPanel>
                </Border>

                <!-- LISTA DE ENLACES -->
                <Border x:Name="ListSection"
                        BorderBrush="{ThemeResource ControlElevationBorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        Visibility="Collapsed">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Cola de descargas" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" x:Name="ListCountText"
                                       FontSize="13"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <ListView x:Name="ItemsListView" SelectionMode="None" MaxHeight="320">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto"
                                          ColumnSpacing="8" Margin="0,2"
                                          ToolTipService.ToolTip="{Binding Message}">
                                        <ic:FluentIcon Icon="{Binding StatusIcon}"
                                                       IconVariant="Regular" IconSize="Size16"
                                                       VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Message}"
                                                       FontSize="12"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding PercentageDisplay}"
                                                   FontSize="13" FontWeight="Medium"
                                                   Foreground="{StaticResource DownloaderAccentBrush}"
                                                   VerticalAlignment="Center" />
                                        <Button Grid.Column="3"
                                                Click="RemoveItem_Click"
                                                Tag="{Binding}"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="4"
                                                VerticalAlignment="Center"
                                                ToolTipService.ToolTip="Quitar de la lista"
                                                ToolTipService.Placement="Top">
                                            <ic:FluentIcon Icon="DismissCircle" IconVariant="Regular" IconSize="Size16"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <!-- ACCIONES -->
                <Button x:Name="StartButton"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Height="44"
                        HorizontalAlignment="Stretch"
                        CornerRadius="6"
                        Click="StartButton_Click"
                        IsEnabled="False"
                        Background="{StaticResource DownloaderAccentBrush}"
                        Foreground="White"
                        BorderBrush="{StaticResource DownloaderAccentBrush}"
                        BorderThickness="1" />

                <!-- PROGRESO -->
                <Border x:Name="ProgressSection"
                        BorderBrush="{ThemeResource ControlElevationBorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        Visibility="Collapsed">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="10">
                            <ProgressRing x:Name="ProcessingRing"
                                          IsActive="False"
                                          IsIndeterminate="True"
                                          Width="26" Height="26"
                                          Foreground="{StaticResource DownloaderAccentBrush}"
                                          VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       x:Name="ProgressTitleText"
                                       Text="Preparando..."
                                       FontSize="16" FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <ic:FluentIcon Grid.Column="2"
                                           x:Name="CompletedIcon"
                                           Icon="CheckmarkCircle"
                                           IconVariant="Filled"
                                           IconSize="Size20"
                                           Foreground="#27AE60"
                                           Visibility="Collapsed"
                                           VerticalAlignment="Center" />
                        </Grid>
                        <ProgressBar x:Name="ProgressBar"
                                     Value="0"
                                     ShowPaused="False"
                                     Foreground="{StaticResource DownloaderAccentBrush}"
                                     CornerRadius="2" />
                        <TextBlock x:Name="ProgressText"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- ACCIONES FINALES -->
                <StackPanel x:Name="EndActionsSection"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Spacing="12"
                            Visibility="Collapsed">
                    <Button x:Name="OpenFolderButton"
                            Click="OpenFolderButton_Click"
                            CornerRadius="4"
                            MinWidth="220"
                            Background="Transparent"
                            Foreground="{StaticResource DownloaderAccentBrush}"
                            BorderBrush="{StaticResource DownloaderAccentBrush}"
                            BorderThickness="1" />
                    <Button x:Name="ClearButton"
                            Click="ClearButton_Click"
                            CornerRadius="4"
                            MinWidth="220"
                            Background="{StaticResource DownloaderAccentBrush}"
                            Foreground="White"
                            BorderBrush="{StaticResource DownloaderAccentBrush}"
                            BorderThickness="1" />
                </StackPanel>

                <!-- RESULTADOS DE MASTERIZACIÓN -->
                <Border x:Name="ResultsSection"
                        BorderBrush="{ThemeResource ControlElevationBorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        Visibility="Collapsed">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Resultados de normalización" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1"
                                       x:Name="SummaryText"
                                       FontSize="13"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                        <ListView x:Name="ResultsListView" SelectionMode="None" MaxHeight="320">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2" ColumnSpacing="8">
                                        <ic:FluentIcon Icon="{Binding StatusIcon}"
                                                       IconVariant="Regular" IconSize="Size16"
                                                       VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FileName}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Message}"
                                                       FontSize="12"
                                                       TextWrapping="Wrap"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding GainDisplay}"
                                                   FontSize="14" FontWeight="Medium"
                                                   Foreground="{StaticResource DownloaderAccentBrush}"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>

        <!-- Overlay de arrastre (.txt con enlaces) -->
        <Border x:Name="Overlay"
                Background="#66000000"
                CornerRadius="12"
                Visibility="Collapsed">
            <StackPanel Orientation="Vertical"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12">
                <Border Width="72" Height="72"
                        CornerRadius="36"
                        Background="{StaticResource DownloaderAccentSoftBrush}"
                        HorizontalAlignment="Center">
                    <ic:FluentIcon Icon="ArrowDownload" IconVariant="Regular" IconSize="Size32"
                                   Foreground="{StaticResource DownloaderAccentBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Suelta para cargar enlaces"
                           FontSize="20" FontWeight="SemiBold"
                           Foreground="White"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Arrastra un archivo .txt con un enlace por línea"
                           FontSize="13"
                           Foreground="#D0FFFFFF"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           MaxWidth="480"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Popup de error: velo + tarjeta que sube rebotando.
             Se eleva al terminar con fallos (o si el motor no está listo);
             "Intentar de nuevo" reprocesa solo los enlaces fallidos. -->
        <Border x:Name="ErrorPopupOverlay"
                Background="#66000000"
                Visibility="Collapsed"
                Tapped="ErrorPopupOverlay_Tapped">
            <Border x:Name="ErrorPopupCard"
                     MaxWidth="420"
                     CornerRadius="16"
                     Padding="24"
                     BorderThickness="1"
                     BorderBrush="{StaticResource DownloaderAccentBrush}"
                     Background="{ThemeResource LayerFillColorDefaultBrush}"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Margin="0">
                <Border.RenderTransform>
                    <TranslateTransform Y="160" />
                </Border.RenderTransform>
                <StackPanel Spacing="12">
                    <Border Width="64" Height="64"
                            CornerRadius="32"
                            Background="#33E67E22"
                            HorizontalAlignment="Center">
                        <ic:FluentIcon Icon="Warning" IconVariant="Regular" IconSize="Size28"
                                       Foreground="#E67E22"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="No se pudo descargar"
                               FontSize="20" FontWeight="Bold"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               HorizontalAlignment="Center" />
                    <TextBlock x:Name="ErrorPopupSubtitle"
                               FontSize="13"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               HorizontalAlignment="Center" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Button x:Name="ErrorPopupRetryButton"
                                Content="Intentar de nuevo"
                                Click="ErrorPopupRetryButton_Click"
                                CornerRadius="6"
                                HorizontalAlignment="Stretch"
                                Background="{StaticResource DownloaderAccentBrush}"
                                Foreground="White"
                                BorderBrush="{StaticResource DownloaderAccentBrush}"
                                BorderThickness="1"
                                FontWeight="SemiBold" />
                        <Button Grid.Column="1"
                                x:Name="ErrorPopupCloseButton"
                                Content="Cerrar"
                                Click="ErrorPopupCloseButton_Click"
                                CornerRadius="6"
                                HorizontalAlignment="Stretch"
                                Background="Transparent"
                                BorderBrush="{ThemeResource ControlElevationBorderBrush}"
                                BorderThickness="1" />
                    </Grid>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Page>
