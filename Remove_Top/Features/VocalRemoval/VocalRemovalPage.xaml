<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Remove_Top.Features.VocalRemoval.VocalRemovalPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Remove_Top.Features.VocalRemoval"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- HEADER: Branding + Título -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <Border CornerRadius="4" Padding="8,2" Background="#9B59B6" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <ic:FluentIcon Icon="MusicNote2" IconVariant="Regular" IconSize="Size12"
                                   Foreground="White" />
                    <TextBlock Text="Top Remix" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                </StackPanel>
            </Border>
            <TextBlock Text="Stems — Extraer Voz"
                       FontSize="28" FontWeight="SemiBold" />
            <TextBlock                        Text="Separa la voz del instrumental usando IA (HD-Demucs). Máximo 5 canciones por lote."
                       FontSize="14"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Margin="0,4,0,0" />
        </StackPanel>

        <!-- CONTENT -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="16">

                <!-- Model Download Section (shown until models are ready) -->
                <Border x:Name="ModelSection"
                        BorderBrush="{ThemeResource ControlElevationBorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        Visibility="Visible">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Modelo de inteligencia artificial"
                                       FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" x:Name="ModelStatusText"
                                       FontSize="13" FontWeight="Medium"
                                       Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock x:Name="ModelInfoText" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Text="Remove-Top necesita descargar un modelo de IA (~316 MB) para separar la voz. La descarga ocurre solo una vez. Después funciona sin internet." />
                        <ProgressBar x:Name="ModelProgressBar" Value="0"
                                     Visibility="Visible" CornerRadius="2" />
                        <Button x:Name="DownloadButton"
                                Click="DownloadButton_Click" CornerRadius="4"
                                HorizontalAlignment="Stretch"
                                Background="Transparent"
                                BorderBrush="#9B59B6"
                                Foreground="#9B59B6"
                                BorderThickness="1.5" />
                    </StackPanel>
                </Border>

                <!-- Folder Selection -->
                <Border x:Name="FolderSection"
                        BorderBrush="{ThemeResource ControlElevationBorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        Visibility="Collapsed">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Carpeta de origen"
                                   FontSize="16" FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBox x:Name="FolderPathBox"
                                     PlaceholderText="Selecciona una carpeta con canciones..."
                                     IsReadOnly="True" CornerRadius="4" />
                            <Button Grid.Column="1" x:Name="BrowseButton"
                                    Content="Examinar..." Click="BrowseButton_Click"
                                    CornerRadius="4"
                                    Background="Transparent"
                                    BorderBrush="#9B59B6"
                                    Foreground="#9B59B6"
                                    BorderThickness="1.5" />
                        </Grid>
                        <TextBlock x:Name="FileCountText" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <!-- Queue (max 5) -->
                <Border x:Name="QueueSection"
                        BorderBrush="{ThemeResource ControlElevationBorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        Visibility="Collapsed">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Canciones seleccionadas"
                                       FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" x:Name="QueueCountText"
                                       FontSize="13" FontWeight="Medium"
                                       Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <ListView x:Name="QueueListView" SelectionMode="None" MaxHeight="200">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8"
                                          Margin="0,2">
                                        <ic:FluentIcon Icon="MusicNote2" IconVariant="Regular"
                                                       IconSize="Size16"
                                                       VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" Text="est&#x00E9;reo"
                                                   FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <!-- Action Button -->
                <Button x:Name="StartButton"
                        FontSize="16" FontWeight="SemiBold" Height="44"
                        HorizontalAlignment="Stretch" CornerRadius="6"
                        Click="StartButton_Click" IsEnabled="False"
                        Background="#9B59B6" Foreground="White" BorderThickness="0" />

                <!-- Progress -->
                <Border x:Name="ProgressSection"
                        BorderBrush="{ThemeResource ControlElevationBorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        Visibility="Collapsed">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Procesando..." FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" x:Name="ProgressCountText"
                                       FontSize="13"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <ProgressBar x:Name="OverallProgressBar"
                                     Value="0" ShowPaused="False" CornerRadius="2" />
                        <ProgressBar x:Name="FileProgressBar"
                                     Value="0" ShowPaused="False" CornerRadius="2"
                                     Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                        <TextBlock x:Name="ProgressText" FontSize="13"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Results -->
                <Border x:Name="ResultsSection"
                        BorderBrush="{ThemeResource ControlElevationBorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        Visibility="Collapsed">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                            <TextBlock Text="Resultados" FontSize="16" FontWeight="SemiBold" />
                            <Border Grid.Column="1" x:Name="CompleteBadge"
                                    CornerRadius="4" Padding="8,2"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    Visibility="Collapsed">
                                <TextBlock x:Name="CompleteText" FontSize="12"
                                           FontWeight="SemiBold" Foreground="White" />
                            </Border>
                            <TextBlock Grid.Column="2" x:Name="SummaryText" FontSize="13"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                        <ListView x:Name="ResultsListView" SelectionMode="None" MaxHeight="320">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2" ColumnSpacing="8">
                                        <ic:FluentIcon Icon="{Binding StatusIcon}"
                                                       IconVariant="Regular" IconSize="Size16"
                                                       VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Message}" FontSize="12"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding OutputPath}"
                                                   FontSize="11" MaxWidth="200"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
