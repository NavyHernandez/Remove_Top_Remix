<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Remove_Top.Features.ImagePreview.ImagePreviewView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignWidth="600"
    d:DesignHeight="300">
    <Grid x:Name="RootGrid">

        <!-- Estado vacío (sin imagen cargada) -->
        <StackPanel x:Name="EmptyState"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6"
                    Visibility="Collapsed">
            <ic:FluentIcon Icon="Image" IconVariant="Regular" IconSize="Size32"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center" />
            <TextBlock Text="Ninguna imagen seleccionada"
                       FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- Estado de carga -->
        <StackPanel x:Name="LoadingState"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                    Visibility="Collapsed">
            <ProgressRing IsActive="True" Width="28" Height="28" />
            <TextBlock Text="Cargando imagen..."
                       FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- Estado de error -->
        <StackPanel x:Name="ErrorState"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6"
                    Visibility="Collapsed">
            <ic:FluentIcon Icon="ErrorCircle" IconVariant="Regular" IconSize="Size32"
                           Foreground="#C0392B"
                           HorizontalAlignment="Center" />
            <TextBlock x:Name="ErrorText"
                       Text="No se pudo abrir la imagen."
                       FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- Imagen ajustada al espacio disponible (sin zoom) -->
        <Image x:Name="PreviewImage"
               Stretch="Uniform"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               IsHitTestVisible="False" />
    </Grid>
</UserControl>