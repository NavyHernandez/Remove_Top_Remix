<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Remove_Top.Features.Normalization.NormalizationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Remove_Top.Features.Normalization"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:audiopreview="using:Remove_Top.Features.AudioPreview"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Unloaded="Page_Unloaded">

    <!-- Zona de arrastre de la página (carpetas y canciones).
         El Grid externo recibe el drop; el interno conserva el contenido.
         El overlay se muestra mientras se arrastra encima (ver Root_DragOver/
         Root_DragLeave/Root_Drop). El fondo transparente es requisito para
         que el área sea válida. -->
    <Grid Background="Transparent"
          AllowDrop="True"
          DragEnter="Root_DragEnter"
          DragOver="Root_DragOver"
          DragLeave="Root_DragLeave"
          Drop="Root_Drop">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============================================================ -->
        <!-- HEADER: Branding + Título y descripción                     -->
        <!-- ============================================================ -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <Border Style="{StaticResource BrandBadgeBorderStyle}" Background="#5B9BD5">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
                    <ic:FluentIcon Icon="Speaker2" IconVariant="Regular" IconSize="Size12"
                                   Foreground="White" />
                    <TextBlock x:Name="BrandText" Text="" Style="{StaticResource BrandTextStyle}" />
                </StackPanel>
            </Border>
            <TextBlock x:Name="PageTitleText"
                       Text=""
                       FontSize="28" FontWeight="SemiBold" />
            <TextBlock x:Name="PageSubtitleText"
                       Text=""
                       FontSize="14"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Margin="0,4,0,0" />
        </StackPanel>

        <!-- ============================================================ -->
        <!-- CONTENT: Scrollable con todas las secciones                  -->
        <!-- ============================================================ -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="16">

                <!-- ==================================================== -->
                <!-- AVISO: Límite de la versión gratuita                 -->
                <!-- ==================================================== -->
                <InfoBar x:Name="LimitInfoBar"
                         Severity="Informational"
                         IsOpen="True"
                         IsClosable="False"
                         Title=""
                         Message="" />

                <!-- ==================================================== -->
                <!-- SECCIÓN: Selección de carpeta de origen              -->
                <!-- ==================================================== -->
                <Border BorderBrush="{ThemeResource ControlElevationBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16"
                        Background="{ThemeResource LayerFillColorDefaultBrush}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Carpeta de origen"
                                   FontSize="16" FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBox x:Name="FolderPathBox"
                                     PlaceholderText="Selecciona una carpeta con archivos de audio..."
                                     IsReadOnly="True"
                                     CornerRadius="4" />
                            <Button Grid.Column="1"
                                    x:Name="BrowseButton"
                                    Content="Examinar..."
                                    Click="BrowseButton_Click"
                                    CornerRadius="4"
                                    Background="Transparent"
                                    BorderBrush="#5B9BD5"
                                    Foreground="#5B9BD5"
                                    BorderThickness="1.5" />
                        </Grid>
                        <TextBlock x:Name="FileCountText"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Visibility="Collapsed" />
                        <TextBlock FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="…o arrastra aquí carpetas o canciones." />
                    </StackPanel>
                </Border>

                <!-- ==================================================== -->
                <!-- SECCIÓN: Análisis de nivel actual                    -->
                <!-- ==================================================== -->
                <Border x:Name="AnalysisSection"
                        BorderBrush="{ThemeResource ControlElevationBorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        Visibility="Collapsed">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Análisis de nivel actual"
                                       FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" x:Name="AnalysisStatusText"
                                       FontSize="13"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <ProgressBar x:Name="AnalysisProgressBar"
                                     IsIndeterminate="True" CornerRadius="2" />
                        <ListView x:Name="AnalysisListView" SelectionMode="None"
                                  MaxHeight="240">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto"
                                          ColumnSpacing="4" Margin="0,2"
                                          ToolTipService.ToolTip="{Binding Message}">
                                        <ic:FluentIcon Icon="{Binding StatusIcon}"
                                                       IconVariant="Regular" IconSize="Size16"
                                                       VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding FileName}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding PeakDbDisplay}"
                                                   FontSize="14" FontWeight="Medium"
                                                   Foreground="#5B9BD5"
                                                   VerticalAlignment="Center" />
                                        <Button Grid.Column="3"
                                                Click="PreviewRowButton_Click"
                                                Tag="{Binding FilePath}"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="4"
                                                VerticalAlignment="Center"
                                                ToolTipService.ToolTip="Previsualizar"
                                                ToolTipService.Placement="Top">
                                            <ic:FluentIcon Icon="Play" IconVariant="Regular" IconSize="Size16"
                                                           Foreground="#5B9BD5" />
                                        </Button>
                                        <Button Grid.Column="4"
                                                Click="RemoveAnalysisItem_Click"
                                                Tag="{Binding FilePath}"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="4"
                                                VerticalAlignment="Center"
                                                ToolTipService.ToolTip="Quitar de la lista"
                                                ToolTipService.Placement="Top">
                                            <ic:FluentIcon Icon="DismissCircle" IconVariant="Regular" IconSize="Size16"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock x:Name="AnalysisSummaryText" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- ==================================================== -->
                <!-- SECCIÓN: Previsualizador de audio (mini reproductor)  -->
                <!-- Reutiliza el módulo de Duplicados: forma de onda con  -->
                <!-- scrub + Play/Pausa/Stop. Un solo preview a la vez.    -->
                <!-- ==================================================== -->
                <Border x:Name="PreviewSection"
                        BorderBrush="{ThemeResource ControlElevationBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        Visibility="Collapsed">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <ic:FluentIcon Icon="MusicNote2" IconVariant="Regular" IconSize="Size16"
                                               Foreground="#5B9BD5" VerticalAlignment="Center" />
                                <TextBlock x:Name="PreviewFileNameText"
                                           FontSize="14" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    x:Name="PreviewCloseButton"
                                    Click="PreviewClose_Click"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="4"
                                    VerticalAlignment="Center"
                                    ToolTipService.ToolTip="Cerrar">
                                <ic:FluentIcon Icon="Dismiss" IconVariant="Regular" IconSize="Size16"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Button>
                        </Grid>

                        <audiopreview:WaveformView x:Name="PreviewWaveform"
                                                   Height="88" />

                        <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
                            <Button x:Name="PreviewPlayButton"
                                    Click="PreviewPlayPause_Click"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="6"
                                    ToolTipService.ToolTip="Reproducir / Pausar" />
                            <Button Grid.Column="1"
                                    x:Name="PreviewStopButton"
                                    Click="PreviewStop_Click"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="6"
                                    ToolTipService.ToolTip="Detener" />
                            <TextBlock Grid.Column="3"
                                       x:Name="PreviewTimeText"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ==================================================== -->
                <!-- SECCIÓN: Control deslizante + caja de texto para dB   -->
                <!-- ==================================================== -->
                <Border BorderBrush="{ThemeResource ControlElevationBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16"
                        Background="{ThemeResource LayerFillColorDefaultBrush}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Nivel objetivo (dBFS)"
                                   FontSize="16" FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <Slider x:Name="TargetSlider"
                                    Minimum="-12"
                                    Maximum="0"
                                    StepFrequency="0.1"
                                    TickFrequency="1"
                                    TickPlacement="Outside"
                                    ValueChanged="TargetSlider_ValueChanged" />
                            <TextBox Grid.Column="1"
                                     x:Name="TargetValueBox"
                                     Text="-1.0"
                                     Width="80"
                                     TextAlignment="Center"
                                     CornerRadius="4"
                                     BeforeTextChanging="TargetValueBox_BeforeTextChanging"
                                     TextChanged="TargetValueBox_TextChanged" />
                        </Grid>
                        <TextBlock FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                            <Run Text="Valores típicos: " />
                            <Run FontWeight="Bold" Text="-0.5 dB" />
                            <Run Text="(máximo volumen) · " />
                            <Run FontWeight="Bold" Text="-1.0 dB" />
                            <Run Text="(recomendado) · " />
                            <Run FontWeight="Bold" Text="-3.0 dB" />
                            <Run Text="(margen de seguridad)" />
                        </TextBlock>
                        <StackPanel Spacing="8">
                            <TextBlock Text="Masterización"
                                       FontSize="16" FontWeight="SemiBold" />
                            <ComboBox x:Name="IntensityComboBox"
                                      HorizontalAlignment="Stretch"
                                      CornerRadius="4" />
                            <TextBlock FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap">
                                <Run Text="Ligera" FontWeight="Bold" />
                                <Run Text=": conserva la dinámica · " />
                                <Run Text="Hard Limiter" FontWeight="Bold" />
                                <Run Text=": limitador con lookahead y clipper suave, sube la sonoridad a ~ -10 LUFS · " />
                                <Run Text="Comercial EDM" FontWeight="Bold" />
                                <Run Text=": densidad de master comercial (~ -8.5 LUFS) con true-peak a -1.0 dBTP, sin saturar." />
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ==================================================== -->
                <!-- BOTÓN DE ACCIÓN: Inicia/Cancela la normalización      -->
                <!-- ==================================================== -->
                <Button x:Name="StartButton"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Height="44"
                        HorizontalAlignment="Stretch"
                        CornerRadius="6"
                        Click="StartButton_Click"
                        IsEnabled="False"
                        Background="#5B9BD5" Foreground="White" BorderThickness="0" />

                <Button x:Name="CancelButton"
                        Content="Limpiar"
                        FontSize="13"
                        Height="36"
                        HorizontalAlignment="Stretch"
                        CornerRadius="6"
                        Click="CancelButton_Click"
                        Visibility="Collapsed"
                        Background="Transparent"
                        BorderBrush="#5B9BD5"
                        Foreground="#5B9BD5"
                        BorderThickness="1" />

                <!-- ==================================================== -->
                <!-- SECCIÓN: Barra de progreso durante el procesamiento   -->
                <!-- ==================================================== -->
                <Border x:Name="ProgressSection"
                        BorderBrush="{ThemeResource ControlElevationBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        Visibility="Collapsed">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="10">
                            <ProgressRing x:Name="ProcessingRing"
                                          IsActive="False"
                                          IsIndeterminate="True"
                                          Width="26"
                                          Height="26"
                                          Foreground="#5B9BD5"
                                          VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       x:Name="ProgressTitleText"
                                       Text="Procesando..."
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <ic:FluentIcon Grid.Column="2"
                                           x:Name="CompletedIcon"
                                           Icon="CheckmarkCircle"
                                           IconVariant="Filled"
                                           IconSize="Size20"
                                           Foreground="#27AE60"
                                           Visibility="Collapsed"
                                           VerticalAlignment="Center" />
                        </Grid>
                        <ProgressBar x:Name="ProgressBar"
                                     Value="0"
                                     ShowPaused="False"
                                     CornerRadius="2" />
                        <TextBlock x:Name="ProgressText"
                                   FontSize="13"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- ==================================================== -->
                <!-- SECCIÓN: Lista de resultados al finalizar             -->
                <!-- ==================================================== -->
                <Border x:Name="ResultsSection"
                        BorderBrush="{ThemeResource ControlElevationBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        Visibility="Collapsed">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Resultados"
                                       FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1"
                                       x:Name="SummaryText"
                                       FontSize="13"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                        <ListView x:Name="ResultsListView"
                                  SelectionMode="None"
                                  MaxHeight="320">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="Auto,*,Auto"
                                          Margin="0,2"
                                          ColumnSpacing="8">
                                        <ic:FluentIcon Icon="{Binding StatusIcon}"
                                                       IconVariant="Regular" IconSize="Size16"
                                                       VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FileName}"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Message}"
                                                       FontSize="12"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding GainDisplay}"
                                                   FontSize="14"
                                                   FontWeight="Medium"
                                                   Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <Button x:Name="ClearButton"
                                Content="Limpiar"
                                Click="ClearButton_Click"
                                CornerRadius="4"
                                HorizontalAlignment="Center"
                                MinWidth="220"
                                Visibility="Collapsed"
                                Background="Transparent"
                                BorderBrush="#5B9BD5"
                                Foreground="#5B9BD5"
                                BorderThickness="1.5" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>

        <!-- Overlay de arrastre: oscurece la página y avisa que se suelte.
             Mismo efecto que DropTargetControl en las otras páginas, con el
             acento de Normalización (#5B9BD5) y su icono. -->
        <Border x:Name="Overlay"
                Background="#66000000"
                CornerRadius="12"
                Visibility="Collapsed">
            <StackPanel Orientation="Vertical"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12">
                <Border Width="72" Height="72"
                        CornerRadius="36"
                        Background="#335B9BD5"
                        HorizontalAlignment="Center">
                    <ic:FluentIcon Icon="FolderOpen" IconVariant="Regular" IconSize="Size32"
                                   Foreground="#5B9BD5"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Suelta para cargar"
                           FontSize="20" FontWeight="SemiBold"
                           Foreground="White"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Arrastra una carpeta o archivos de audio"
                           FontSize="13"
                           Foreground="#D0FFFFFF"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           MaxWidth="480"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
