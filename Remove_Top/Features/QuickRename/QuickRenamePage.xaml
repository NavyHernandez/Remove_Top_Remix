<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Remove_Top.Features.QuickRename.QuickRenamePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Remove_Top.Features.QuickRename"
    xmlns:controls="using:Remove_Top.Controls"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <local:ChipBackgroundConverter x:Key="ChipBackgroundConverter" />

        <!-- Entrada del popup de patrón: la tarjeta sube con rebote y el velo aparece con fundido. -->
        <Storyboard x:Name="PatternPopupShowStoryboard">
            <DoubleAnimation Storyboard.TargetName="PatternPopupCard"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                             From="160" To="0" Duration="0:0:0.7">
                <DoubleAnimation.EasingFunction>
                    <BounceEase Bounces="3" Bounciness="2" EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="PatternPopupOverlay"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.25" />
        </Storyboard>
    </Page.Resources>

    <controls:DropTargetControl
        FilesDropped="DropTarget_FilesDropped"
        DropFailed="DropTarget_DropFailed"
        Caption="Suelta para cargar"
        Subtitle="Arrastra una carpeta o archivos .mp3/.wav"
        AccentColor="#E67E22">

        <controls:DropTargetControl.Host>
        <Grid>
        <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============================================================ -->
        <!-- HEADER: Branding + Título                                   -->
        <!-- ============================================================ -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <Border Style="{StaticResource BrandBadgeBorderStyle}" Background="#E67E22">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
                    <ic:FluentIcon Icon="Rename" IconVariant="Regular" IconSize="Size12"
                                   Foreground="White" />
                    <TextBlock x:Name="BrandText" Text="" Style="{StaticResource BrandTextStyle}" />
                </StackPanel>
            </Border>
            <TextBlock x:Name="PageTitleText"
                       Text=""
                       FontSize="28" FontWeight="SemiBold" />
            <TextBlock x:Name="PageSubtitleText"
                       Text=""
                       FontSize="14"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Margin="0,4,0,0" />
        </StackPanel>

        <!-- ============================================================ -->
        <!-- CONTENT                                                      -->
        <!-- ============================================================ -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="16">

                <!-- ==================================================== -->
                <!-- SECCIÓN: Origen (carpeta / archivos / arrastre)      -->
                <!-- ==================================================== -->
                <!-- El tope de archivos (MaxFiles) se configura en código desde
                     AppLimits.QuickRenameMaxFilesToScan para no desincronizar
                     el comportamiento real con el mensaje mostrado. -->
                <controls:FileSourceControl
                    x:Name="Source"
                    AccentColor="#E67E22"
                    ScanRecursive="True"
                    ShowBrandSite="True"
                    ShowClearButton="False"
                    StateChanged="Source_StateChanged" />
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,-8,0,0">
                    <Border CornerRadius="4" Padding="8,2" Background="#70AD47">
                        <TextBlock x:Name="FreeBadgeText"
                                   Text=""
                                   FontSize="11" FontWeight="SemiBold" Foreground="White" />
                    </Border>
                    <TextBlock x:Name="LimitInfoText"
                               FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="FileCountText"
                           FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Visibility="Collapsed" />

                <!-- ==================================================== -->
                <!-- SECCIÓN: Lista editable de archivos                  -->
                <!-- ==================================================== -->
                <Border x:Name="ListSection"
                        BorderBrush="{ThemeResource ControlElevationBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        Visibility="Collapsed">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="12">
                            <TextBlock Text="Nombres editables"
                                       FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1"
                                       x:Name="DirtyCountText"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right" />
                            <Button Grid.Column="2"
                                     x:Name="ReorderButton"
                                    Click="ReorderButton_Click"
                                    CornerRadius="4"
                                    IsEnabled="False"
                                    Background="Transparent"
                                    BorderBrush="#E67E22"
                                    Foreground="#E67E22"
                                    BorderThickness="1.5"
                                    ToolTipService.ToolTip="Dividir el nombre en partes y reordenarlas (guion o espacio)" />
                            <DropDownButton Grid.Column="3"
                                     x:Name="CaseButton"
                                     CornerRadius="4"
                                     Padding="6"
                                     IsEnabled="False"
                                     Background="Transparent"
                                     BorderBrush="#E67E22"
                                     Foreground="#E67E22"
                                     BorderThickness="1.5"
                                     ToolTipService.ToolTip="Cambiar mayúsculas / minúsculas">
                                <DropDownButton.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem x:Name="UppercaseItem"
                                                        Text="MAYÚSCULAS"
                                                        Tag="upper"
                                                        FontSize="12"
                                                        Click="CaseItem_Click" />
                                        <MenuFlyoutItem x:Name="LowercaseItem"
                                                        Text="minúsculas"
                                                        Tag="lower"
                                                        FontSize="12"
                                                        Click="CaseItem_Click" />
                                        <MenuFlyoutItem x:Name="TitleCaseItem"
                                                        Text="Capitalizar Palabras"
                                                        Tag="title"
                                                        FontSize="12"
                                                        Click="CaseItem_Click" />
                                    </MenuFlyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>
                            <Button Grid.Column="4"
                                     x:Name="RefreshButton"
                                    Click="RefreshButton_Click"
                                    CornerRadius="4"
                                    Padding="6"
                                    IsEnabled="False"
                                    Background="Transparent"
                                    BorderBrush="#E67E22"
                                    Foreground="#E67E22"
                                    BorderThickness="1.5"
                                    ToolTipService.ToolTip="Volver a leer los archivos cargados" />
                            <Button Grid.Column="5"
                                     x:Name="ResetButton"
                                    Content="Restaurar originales"
                                    Click="ResetButton_Click"
                                    CornerRadius="4"
                                    IsEnabled="False"
                                    Background="Transparent"
                                    BorderBrush="#E67E22"
                                    Foreground="#E67E22"
                                    BorderThickness="1.5" />
                            <Button Grid.Column="6"
                                     x:Name="AddPatternButton"
                                    Click="AddPatternButton_Click"
                                    CornerRadius="4"
                                    IsEnabled="False"
                                    Background="Transparent"
                                    BorderBrush="#E67E22"
                                    Foreground="#E67E22"
                                    BorderThickness="1.5"
                                    ToolTipService.ToolTip="Agregar un texto al inicio, centro o final de todos los nombres" />
                        </Grid>
                        <ListView x:Name="FilesListView"
                                  SelectionMode="None"
                                  MaxHeight="380">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="Auto,Auto,*,Auto"
                                          ColumnSpacing="8"
                                          Margin="0,2">
                                        <CheckBox x:Name="GuideCheckBox"
                                                  IsChecked="{Binding IsGuide, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Click="GuideCheckBox_Click"
                                                  VerticalAlignment="Center"
                                                  MinWidth="24"
                                                  ToolTipService.ToolTip="Marcar como canción guía para reordenar" />
                                        <ic:FluentIcon Grid.Column="1"
                                                       Icon="{Binding Icon}"
                                                       IconVariant="Regular" IconSize="Size16"
                                                       VerticalAlignment="Center" />
                                        <TextBox Grid.Column="2"
                                                 Text="{Binding CurrentName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 CornerRadius="4"
                                                 FontFamily="Consolas" />
                                        <StackPanel Grid.Column="3"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding OriginalName}"
                                                       FontSize="11"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                            <Run Text="Edita los nombres en las cajas de texto y pulsa " />
                            <Run FontWeight="Bold" Text="Aplicar cambios" />
                            <Run Text=". La extensión se puede modificar." />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- ==================================================== -->
                <!-- REORDENAR PARTES DEL NOMBRE                       -->
                <!-- ==================================================== -->
                <Border x:Name="ReorderSection"
                        BorderBrush="{ThemeResource ControlElevationBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        Visibility="Collapsed">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <TextBlock Text="Reordenar partes"
                                       FontSize="16" FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <Button x:Name="UndoReorderButton"
                                        Click="UndoReorderButton_Click"
                                        Padding="6"
                                        CornerRadius="4"
                                        IsEnabled="False"
                                        Background="Transparent"
                                        BorderBrush="#E67E22"
                                        Foreground="#E67E22"
                                        BorderThickness="1.5"
                                        ToolTipService.ToolTip="Deshacer el último cambio" />
                                <TextBlock Text="Separador:"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Center" />
                                <ComboBox x:Name="SeparatorCombo"
                                          SelectedIndex="1"
                                          SelectionChanged="SeparatorCombo_SelectionChanged"
                                          MinWidth="140" />
                            </StackPanel>
                        </Grid>

                        <TextBlock x:Name="ReorderSampleText"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />

                        <TextBlock Text="Arrastra las etiquetas para ordenarlas:"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <ListView x:Name="ReorderList"
                                  SelectionMode="None"
                                  CanReorderItems="True"
                                  AllowDrop="True"
                                  HorizontalContentAlignment="Stretch">
                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsStackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="8" Padding="8,4"
                                            Background="{Binding Converter={StaticResource ChipBackgroundConverter}}"
                                            DoubleTapped="ReorderChip_DoubleTapped"
                                            RightTapped="ReorderChip_RightTapped"
                                            Margin="0,2">
                                        <StackPanel Orientation="Horizontal" Spacing="6"
                                                    VerticalAlignment="Center">
                                            <Border CornerRadius="4" Padding="4,1"
                                                    Background="#E67E22">
                                                <TextBlock Text="{Binding BadgeText}"
                                                           FontSize="10" FontWeight="SemiBold"
                                                           Foreground="White"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="{Binding Text}"
                                                       FontSize="12"
                                                       VerticalAlignment="Center"
                                                       TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <TextBlock x:Name="ReorderHelpText"
                                   FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Text="Doble clic en una etiqueta la selecciona como fuente y doble clic en otra la une a un solo bloque. Clic derecho en un bloque unido lo separa." />

                        <TextBlock x:Name="ReorderPreviewListHeader"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="Vista previa de los primeros archivos (10)" />
                        <ListView x:Name="ReorderPreviewList"
                                  SelectionMode="None"
                                  MaxHeight="200"
                                  Visibility="Collapsed">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8"
                                          Margin="0,2">
                                        <TextBlock Text="&#x2022;"
                                                   FontSize="12"
                                                   Foreground="#E67E22"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Result}"
                                                   FontSize="12"
                                                   FontFamily="Consolas"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                            <Button x:Name="ApplyReorderButton"
                                    Content="Aplicar a todos"
                                    Click="ApplyReorderButton_Click"
                                    CornerRadius="4"
                                    Height="36"
                                    HorizontalAlignment="Right"
                                    Background="#E67E22" Foreground="White" BorderThickness="0" />
                            <Button Grid.Column="1"
                                    x:Name="CancelReorderButton"
                                    Content="Cancelar"
                                    Click="CancelReorderButton_Click"
                                    CornerRadius="4"
                                    Height="36"
                                    Background="Transparent"
                                    BorderBrush="#E67E22"
                                    Foreground="#E67E22"
                                    BorderThickness="1.5" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ==================================================== -->
                <!-- BOTONES DE ACCIÓN: Limpiar (tras aplicar) + Aplicar -->
                <!-- ==================================================== -->
                <Button x:Name="CleanButton"
                        Click="CleanButton_Click"
                        CornerRadius="4"
                        HorizontalAlignment="Center"
                        MinWidth="220"
                        Margin="0,0,0,8"
                        Visibility="Collapsed"
                        Background="Transparent"
                        BorderBrush="#E67E22"
                        Foreground="#E67E22"
                        BorderThickness="1.5" />
                <Button x:Name="StartButton"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Height="44"
                        HorizontalAlignment="Stretch"
                        CornerRadius="6"
                        Click="StartButton_Click"
                        IsEnabled="False"
                        Background="#E67E22" Foreground="White" BorderThickness="0" />

                <!-- ==================================================== -->
                <!-- RESULTADO                                             -->
                <!-- ==================================================== -->
                <Border x:Name="ResultSection"
                        BorderBrush="{ThemeResource ControlElevationBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        Visibility="Collapsed">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <TextBlock x:Name="ResultSummaryText"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <Border Grid.Column="1"
                                    x:Name="CompleteBadge"
                                    CornerRadius="4"
                                    Padding="8,2"
                                    Background="#E67E22"
                                    Visibility="Collapsed">
                                <TextBlock x:Name="CompleteText"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="White" />
                            </Border>
                        </Grid>
                        <TextBlock x:Name="ResultSuccessTitle"
                                   Text="Archivos renombrados:"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Visibility="Collapsed" />
                        <ListView x:Name="ResultSuccessList"
                                  SelectionMode="None"
                                  MaxHeight="160"
                                  Visibility="Collapsed">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2">
                                        <ic:FluentIcon Icon="CheckmarkCircle"
                                                       IconVariant="Regular" IconSize="Size16"
                                                       Foreground="#70AD47"
                                                       VerticalAlignment="Center" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding OriginalName}"
                                                       FontSize="12" FontWeight="SemiBold" />
                                            <TextBlock FontSize="11"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       TextWrapping="Wrap"><Run Text="→ " /><Run Text="{Binding NewName}" /></TextBlock>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock x:Name="ResultSuccessMore"
                                   FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Visibility="Collapsed" />
                        <TextBlock x:Name="ResultErrorsTitle"
                                   Text="Archivos que no se pudieron renombrar:"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Visibility="Collapsed" />
                        <ListView x:Name="ResultErrorsList"
                                  SelectionMode="None"
                                  MaxHeight="160"
                                  Visibility="Collapsed">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2">
                                        <ic:FluentIcon Icon="DismissCircle"
                                                       IconVariant="Regular" IconSize="Size16"
                                                       Foreground="#E67E22"
                                                       VerticalAlignment="Center" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding Item.OriginalName}"
                                                       FontSize="12" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Message}"
                                                       FontSize="11"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
        </Grid>

        <!-- Popup Agregar patrón: velo + tarjeta que sube rebotando.
             Pre-llena los nombres en la lista; lo definitivo es "Aplicar cambios". -->
        <Border x:Name="PatternPopupOverlay"
                Background="#66000000"
                Visibility="Collapsed"
                Tapped="PatternPopupOverlay_Tapped">
            <Border x:Name="PatternPopupCard"
                    MaxWidth="420"
                    CornerRadius="16"
                    Padding="24"
                    BorderThickness="1"
                    BorderBrush="#E67E22"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Border.RenderTransform>
                    <TranslateTransform Y="160" />
                </Border.RenderTransform>
                <StackPanel Spacing="12">
                    <TextBlock Text="Agregar patrón"
                               FontSize="20" FontWeight="Bold"
                               TextAlignment="Center"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Este texto se agregará a todos los nombres cargados."
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               HorizontalAlignment="Center" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox x:Name="PatternTextBox"
                                 PlaceholderText="Ej. REMIX"
                                 TextChanged="PatternTextBox_TextChanged" />
                        <TextBlock Grid.Column="1"
                                   x:Name="PatternCountText"
                                   Text="0/15"
                                   FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock x:Name="PatternErrorText"
                               FontSize="12"
                               Foreground="#E74C3C"
                               TextWrapping="Wrap"
                               Visibility="Collapsed" />
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="4">
                        <RadioButton x:Name="PatternStartRadio"
                                     Content="Al inicio"
                                     IsChecked="True"
                                     Checked="PatternPosition_Checked"
                                     FontSize="13"
                                     MinWidth="0"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center" />
                        <RadioButton Grid.Column="1"
                                     x:Name="PatternMiddleRadio"
                                     Content="Al centro"
                                     Checked="PatternPosition_Checked"
                                     FontSize="13"
                                     MinWidth="0"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center" />
                        <RadioButton Grid.Column="2"
                                     x:Name="PatternEndRadio"
                                     Content="Al final"
                                     Checked="PatternPosition_Checked"
                                     FontSize="13"
                                     MinWidth="0"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock x:Name="PatternPreviewText"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"
                               TextAlignment="Center" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Button x:Name="PatternAcceptButton"
                                Content="Agregar"
                                Click="PatternAcceptButton_Click"
                                CornerRadius="6"
                                HorizontalAlignment="Stretch"
                                Height="40"
                                Background="#E67E22"
                                Foreground="White"
                                BorderThickness="0"
                                FontWeight="SemiBold" />
                        <Button Grid.Column="1"
                                x:Name="PatternCancelButton"
                                Content="Cancelar"
                                Click="PatternCancelButton_Click"
                                CornerRadius="6"
                                HorizontalAlignment="Stretch"
                                Height="40"
                                Background="Transparent"
                                BorderBrush="#E67E22"
                                Foreground="#E67E22"
                                BorderThickness="1.5" />
                    </Grid>
                </StackPanel>
            </Border>
        </Border>
        </Grid>
        </controls:DropTargetControl.Host>
    </controls:DropTargetControl>
</Page>
