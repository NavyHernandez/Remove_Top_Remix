<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Remove_Top.Features.QuickRename.QuickRenamePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Remove_Top.Features.QuickRename"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============================================================ -->
        <!-- HEADER: Branding + Título                                   -->
        <!-- ============================================================ -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <Border CornerRadius="4" Padding="8,2" Background="#E67E22" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <ic:FluentIcon Icon="MusicNote2" IconVariant="Regular" IconSize="Size12"
                                   Foreground="White" />
                    <TextBlock Text="Top Remix" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                </StackPanel>
            </Border>
            <TextBlock Text="Edición Rápida de Nombres"
                       FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="Lista los archivos .mp3 y .wav de la carpeta y edita sus nombres de forma rápida."
                       FontSize="14"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Margin="0,4,0,0" />
        </StackPanel>

        <!-- ============================================================ -->
        <!-- CONTENT                                                      -->
        <!-- ============================================================ -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="16">

                <!-- ==================================================== -->
                <!-- SECCIÓN: Carpeta de origen                           -->
                <!-- ==================================================== -->
                <Border BorderBrush="{ThemeResource ControlElevationBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16"
                        Background="{ThemeResource LayerFillColorDefaultBrush}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Carpeta de origen"
                                   FontSize="16" FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBox x:Name="FolderPathBox"
                                     PlaceholderText="Selecciona una carpeta con archivos .mp3 o .wav..."
                                     IsReadOnly="True"
                                     CornerRadius="4" />
                            <Button Grid.Column="1"
                                    x:Name="BrowseButton"
                                    Content="Examinar..."
                                    Click="BrowseButton_Click"
                                    CornerRadius="4"
                                    Background="Transparent"
                                    BorderBrush="#E67E22"
                                    Foreground="#E67E22"
                                    BorderThickness="1.5" />
                        </Grid>
                        <TextBlock x:Name="FileCountText"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <!-- ==================================================== -->
                <!-- SECCIÓN: Lista editable de archivos                  -->
                <!-- ==================================================== -->
                <Border x:Name="ListSection"
                        BorderBrush="{ThemeResource ControlElevationBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        Visibility="Collapsed">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                            <TextBlock Text="Nombres editables"
                                       FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1"
                                       x:Name="DirtyCountText"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="2"
                                    x:Name="ResetButton"
                                    Content="Restaurar originales"
                                    Click="ResetButton_Click"
                                    CornerRadius="4"
                                    IsEnabled="False"
                                    Background="Transparent"
                                    BorderBrush="#E67E22"
                                    Foreground="#E67E22"
                                    BorderThickness="1.5" />
                        </Grid>
                        <ListView x:Name="FilesListView"
                                  SelectionMode="None"
                                  MaxHeight="380">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="Auto,*,Auto"
                                          ColumnSpacing="8"
                                          Margin="0,2">
                                        <ic:FluentIcon Icon="{Binding Icon}"
                                                       IconVariant="Regular" IconSize="Size16"
                                                       VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1"
                                                 Text="{Binding CurrentName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 CornerRadius="4"
                                                 FontFamily="Consolas" />
                                        <StackPanel Grid.Column="2"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding OriginalName}"
                                                       FontSize="11"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                            <Run Text="Edita los nombres en las cajas de texto y pulsa " />
                            <Run FontWeight="Bold" Text="Aplicar cambios" />
                            <Run Text=". La extensión se puede modificar." />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- ==================================================== -->
                <!-- SECCIÓN: Corrección con IA                            -->
                <!-- ==================================================== -->
                <Border x:Name="AiSection"
                        BorderBrush="{ThemeResource ControlElevationBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        Visibility="Collapsed">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Corrección con IA"
                                   FontSize="16" FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <TextBlock Text="Proveedor:"
                                       FontSize="13"
                                       VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1"
                                      x:Name="ProviderComboBox"
                                      HorizontalAlignment="Stretch"
                                      CornerRadius="4"
                                      SelectionChanged="ProviderComboBox_SelectionChanged">
                                <ComboBoxItem x:Name="ProviderMockItem"
                                              Content="Prueba local (Mock)"
                                              Tag="mock" />
                                <ComboBoxItem x:Name="ProviderGroqItem"
                                              Content="Groq (API real)"
                                              Tag="groq" />
                            </ComboBox>
                            <PasswordBox Grid.Column="2"
                                         x:Name="ApiKeyBox"
                                         PlaceholderText="API Key de Groq"
                                         Width="220"
                                         CornerRadius="4"
                                         IsEnabled="False"
                                         PasswordChanged="ApiKeyBox_PasswordChanged" />
                        </Grid>
                        <TextBlock x:Name="AiStatusText"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                        <ProgressBar x:Name="AiProgressBar"
                                     IsIndeterminate="True"
                                     CornerRadius="2"
                                     Visibility="Collapsed" />
                        <Button x:Name="CorrectButton"
                                FontSize="14" FontWeight="SemiBold"
                                Height="40"
                                HorizontalAlignment="Stretch"
                                CornerRadius="6"
                                Click="CorrectButton_Click"
                                IsEnabled="False"
                                Background="Transparent"
                                BorderBrush="#E67E22"
                                Foreground="#E67E22"
                                BorderThickness="1.5" />
                    </StackPanel>
                </Border>

                <!-- ==================================================== -->
                <!-- SECCIÓN: Sugerencias de IA con checkboxes             -->
                <!-- ==================================================== -->
                <Border x:Name="SuggestionsSection"
                        BorderBrush="{ThemeResource ControlElevationBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        Visibility="Collapsed">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <CheckBox x:Name="ApproveAllCheckBox"
                                      Content="Aprobar todos"
                                      Click="ApproveAllCheckBox_Click"
                                      VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       x:Name="ApprovedCountText"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="2"
                                    x:Name="ApplyApprovedButton"
                                    Content="Aplicar aprobados"
                                    Click="ApplyApprovedButton_Click"
                                    CornerRadius="4"
                                    IsEnabled="False"
                                    Background="Transparent"
                                    BorderBrush="#E67E22"
                                    Foreground="#E67E22"
                                    BorderThickness="1.5" />
                        </Grid>
                        <ListView x:Name="SuggestionsListView"
                                  SelectionMode="None"
                                  MaxHeight="320">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="Auto,Auto,*,Auto,*,Auto"
                                          ColumnSpacing="8"
                                          Margin="0,2">
                                        <CheckBox IsChecked="{Binding IsApproved, Mode=TwoWay}"
                                                  VerticalAlignment="Center" />
                                        <ic:FluentIcon Grid.Column="1"
                                                       Icon="{Binding StatusIcon}"
                                                       IconVariant="Regular" IconSize="Size16"
                                                       VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding OriginalFull}"
                                                       FontSize="12"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <ic:FluentIcon Grid.Column="3"
                                                       Icon="ArrowRight"
                                                       IconVariant="Regular" IconSize="Size12"
                                                       VerticalAlignment="Center"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SuggestedFull}"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <!-- ==================================================== -->
                <!-- BOTÓN DE ACCIÓN                                       -->
                <!-- ==================================================== -->
                <Button x:Name="StartButton"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Height="44"
                        HorizontalAlignment="Stretch"
                        CornerRadius="6"
                        Click="StartButton_Click"
                        IsEnabled="False"
                        Background="#E67E22" Foreground="White" BorderThickness="0" />

                <!-- ==================================================== -->
                <!-- SECCIÓN: Progreso                                     -->
                <!-- ==================================================== -->
                <Border x:Name="ProgressSection"
                        BorderBrush="{ThemeResource ControlElevationBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        Visibility="Collapsed">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Renombrando..."
                                       FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1"
                                       x:Name="ProgressCountText"
                                       FontSize="13"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <ProgressBar x:Name="ProgressBar"
                                     Value="0"
                                     ShowPaused="False"
                                     CornerRadius="2" />
                        <TextBlock x:Name="ProgressText"
                                   FontSize="13"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- ==================================================== -->
                <!-- SECCIÓN: Resultados                                   -->
                <!-- ==================================================== -->
                <Border x:Name="ResultsSection"
                        BorderBrush="{ThemeResource ControlElevationBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        Visibility="Collapsed">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                            <TextBlock Text="Resultados"
                                       FontSize="16" FontWeight="SemiBold" />
                            <Border Grid.Column="1"
                                    x:Name="CompleteBadge"
                                    CornerRadius="4"
                                    Padding="8,2"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    Visibility="Collapsed">
                                <TextBlock x:Name="CompleteText"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="White" />
                            </Border>
                            <TextBlock Grid.Column="2"
                                       x:Name="SummaryText"
                                       FontSize="13"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                        <ListView x:Name="ResultsListView"
                                  SelectionMode="None"
                                  MaxHeight="320">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="Auto,*,Auto"
                                          Margin="0,2"
                                          ColumnSpacing="8">
                                        <ic:FluentIcon Icon="{Binding StatusIcon}"
                                                       IconVariant="Regular" IconSize="Size16"
                                                       VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding OriginalName}"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Message}"
                                                       FontSize="12"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding NewName}"
                                                   FontSize="12"
                                                   FontWeight="Medium"
                                                   Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
