<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Remove_Top.Features.TagRemoval.TagSourceControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Unloaded="UserControl_Unloaded">

    <StackPanel Spacing="16">
        <!-- ============================================================ -->
        <!-- TARJETA: Selección de origen (carpeta / archivos / drag)     -->
        <!-- ============================================================ -->
        <Border x:Name="SourceCard"
                BorderBrush="{ThemeResource ControlElevationBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16"
                Background="{ThemeResource LayerFillColorDefaultBrush}">
            <StackPanel Spacing="12">
                <TextBlock Text="Origen"
                           FontSize="16" FontWeight="SemiBold" />
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <TextBox x:Name="SourcePathBox"
                             PlaceholderText="Selecciona una carpeta o archivos de audio..."
                             IsReadOnly="True"
                             CornerRadius="4" />
                    <Button Grid.Column="1"
                            x:Name="BrowseFolderButton"
                            Content="Carpeta..."
                            Click="BrowseFolderButton_Click"
                            CornerRadius="4"
                            Background="Transparent"
                            BorderBrush="#B8860B"
                            Foreground="#B8860B"
                            BorderThickness="1.5" />
                    <Button Grid.Column="2"
                            x:Name="BrowseFilesButton"
                            Content="Archivos..."
                            Click="BrowseFilesButton_Click"
                            CornerRadius="4"
                            Background="Transparent"
                            BorderBrush="#B8860B"
                            Foreground="#B8860B"
                            BorderThickness="1.5" />
                </Grid>
                <!-- Pista visual de arrastre (el destino real es toda la página) -->
                <Border x:Name="DropZone"
                        Background="#0AB8860B"
                        CornerRadius="4"
                        Padding="12">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Spacing="8">
                        <ic:FluentIcon Icon="Tag" IconVariant="Regular" IconSize="Size16"
                                       Foreground="#B8860B"
                                       VerticalAlignment="Center" />
                        <TextBlock Text="Arrastra aquí carpetas o archivos de audio (los archivos se usan tal cual; las carpetas se escanean incluyendo subcarpetas)."
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- ============================================================ -->
        <!-- TARJETA: Análisis de archivos encontrados                    -->
        <!-- ============================================================ -->
        <Border x:Name="AnalysisSection"
                BorderBrush="{ThemeResource ControlElevationBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                Visibility="Collapsed">
            <StackPanel Spacing="12">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Archivos encontrados"
                               FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1"
                               x:Name="AnalysisCountText"
                               FontSize="13"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" />
                </Grid>
                <ProgressBar x:Name="AnalysisProgressBar"
                             IsIndeterminate="True"
                             CornerRadius="2"
                             Visibility="Collapsed" />
                <ListView x:Name="AnalysisListView"
                          SelectionMode="None"
                          MaxHeight="220">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2" ColumnSpacing="8">
                                <ic:FluentIcon Icon="MusicNote2" IconVariant="Regular"
                                               IconSize="Size16"
                                               VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding FileName}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding CurrentInfo}"
                                               FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="2"
                                           Text="{Binding CoverStatus}"
                                           FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock x:Name="AnalysisStatusText"
                           FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" />
                <Button x:Name="ClearLoadedButton"
                        Content="Limpiar"
                        Click="ClearLoadedButton_Click"
                        HorizontalAlignment="Center"
                        MinWidth="200"
                        CornerRadius="4"
                        Background="Transparent"
                        BorderBrush="#B8860B"
                        Foreground="#B8860B"
                        BorderThickness="1.5" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>