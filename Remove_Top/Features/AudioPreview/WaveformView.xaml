<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Remove_Top.Features.AudioPreview.WaveformView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    mc:Ignorable="d"
    d:DesignWidth="600"
    d:DesignHeight="88">
    <Grid x:Name="RootGrid"
          Background="Transparent"
          SizeChanged="RootGrid_SizeChanged"
          PointerPressed="RootGrid_PointerPressed"
          PointerMoved="RootGrid_PointerMoved"
          PointerReleased="RootGrid_PointerReleased"
          PointerCaptureLost="RootGrid_PointerCaptureLost">

        <!--
            Onda: una sola Path con un segmento vertical por columna (min → max).
            El tramo ya reproducido se muestra en el color de acento a plena
            opacidad; el tramo futuro queda atenuado por el rectángulo translúcido
            FutureOverlay, que se ancla a la derecha y se encoge al avanzar.
        -->
        <Path x:Name="WavePath"
              Stretch="None"
              IsHitTestVisible="False" />

        <Border x:Name="FutureOverlay"
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                Background="#33000000"
                IsHitTestVisible="False"
                Visibility="Collapsed" />

        <Line x:Name="PlayheadLine"
              Stroke="White"
              StrokeThickness="1.5"
              IsHitTestVisible="False"
              Visibility="Collapsed" />
    </Grid>
</UserControl>