<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Remove_Top.Features.Account.AccountPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Remove_Top.Features.Account"
    xmlns:assets="using:Remove_Top.Assets"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============================================================ -->
        <!-- HEADER: Branding + Título                                    -->
        <!-- ============================================================ -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <Border Style="{StaticResource BrandBadgeBorderStyle}" Background="#00A88F">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
                    <ic:FluentIcon Icon="Person" IconVariant="Regular" IconSize="Size12"
                                   Foreground="White" />
                    <TextBlock x:Name="BrandText" Text="" Style="{StaticResource BrandTextStyle}" />
                </StackPanel>
            </Border>
            <TextBlock x:Name="PageTitleText"
                       Text=""
                       FontSize="28" FontWeight="SemiBold" />
            <TextBlock x:Name="PageSubtitleText"
                       Text=""
                       FontSize="14"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Margin="0,4,0,0" />
        </StackPanel>

        <!-- ============================================================ -->
        <!-- CONTENT                                                      -->
        <!-- ============================================================ -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="16">

                <!-- ==================================================== -->
                <!-- SECCIÓN: Logo profesional                             -->
                <!-- ==================================================== -->
                <Border BorderBrush="{ThemeResource ControlElevationBorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16"
                        Background="{ThemeResource LayerFillColorDefaultBrush}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Top Dj App"
                                   FontSize="16" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <assets:BrandLogo Width="120" Height="120" HorizontalAlignment="Center" />
                        <TextBlock x:Name="AppSiteText"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- ==================================================== -->
                <!-- SECCIÓN: Perfil / Login                               -->
                <!-- ==================================================== -->
                <Border BorderBrush="{ThemeResource ControlElevationBorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16"
                        Background="{ThemeResource LayerFillColorDefaultBrush}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Perfil" FontSize="16" FontWeight="SemiBold" />

                        <!-- Avatar + datos del usuario -->
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Border x:Name="AvatarCircle"
                                    Width="56" Height="56" CornerRadius="28"
                                    Background="#00A88F" VerticalAlignment="Center">
                                <ic:FluentIcon x:Name="AvatarIcon"
                                               Icon="Person" IconVariant="Regular" IconSize="Size28"
                                               Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="ProfileNameText"
                                           FontSize="16" FontWeight="SemiBold" />
                                <TextBlock x:Name="ProfileEmailText"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>

                        <!-- Acciones de sesión -->
                        <Button x:Name="LoginButton"
                                HorizontalAlignment="Center"
                                Click="LoginButton_Click"
                                CornerRadius="4"
                                Padding="16,8"
                                Background="#00A88F"
                                Foreground="White">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ic:FluentIcon Icon="PersonLock" IconVariant="Regular" IconSize="Size16"
                                               Foreground="White" />
                                <TextBlock Text="Iniciar sesión con Google" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="LogoutButton"
                                HorizontalAlignment="Center"
                                Click="LogoutButton_Click"
                                Visibility="Collapsed"
                                CornerRadius="4"
                                Background="Transparent"
                                BorderBrush="#00A88F"
                                Foreground="#00A88F"
                                BorderThickness="1.5">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ic:FluentIcon Icon="SignOut" IconVariant="Regular" IconSize="Size16"
                                               Foreground="#00A88F" />
                                <TextBlock Text="Cerrar sesión" />
                            </StackPanel>
                        </Button>

                        <TextBlock x:Name="LoginNoteText"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Text="El inicio de sesión con Google estará disponible en una próxima versión." />
                    </StackPanel>
                </Border>

                <!-- ==================================================== -->
                <!-- SECCIÓN: Actualizaciones de la app                     -->
                <!-- ==================================================== -->
                <Border BorderBrush="{ThemeResource ControlElevationBorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16"
                        Background="{ThemeResource LayerFillColorDefaultBrush}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Actualizaciones" FontSize="16" FontWeight="SemiBold" />

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <StackPanel Spacing="2">
                                <TextBlock x:Name="InstalledVersionText"
                                           FontSize="13" FontWeight="Medium" />
                                <TextBlock x:Name="LatestVersionText"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <Border x:Name="UpdateStatusBadge"
                                    Grid.Column="1"
                                    CornerRadius="12" Padding="10,4"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <ic:FluentIcon x:Name="UpdateStatusIcon"
                                                   Icon="QuestionCircle" IconVariant="Regular"
                                                   IconSize="Size16" Foreground="White" />
                                    <TextBlock x:Name="UpdateStatusText"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="White" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Button x:Name="CheckUpdatesButton"
                                HorizontalAlignment="Center"
                                Click="CheckUpdatesButton_Click"
                                CornerRadius="4"
                                Background="Transparent"
                                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                BorderThickness="1.5">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ic:FluentIcon Icon="ArrowSync" IconVariant="Regular" IconSize="Size16"
                                               Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                <TextBlock Text="Buscar actualizaciones" />
                            </StackPanel>
                        </Button>

                        <TextBlock x:Name="UpdateNoteText"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Text="Comprobación en modo simulado: se conectará al repositorio/servidor en una próxima versión." />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
