<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Remove_Top.Controls.DropTargetControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Unloaded="UserControl_Unloaded">

    <!--
        Destino de arrastre reutilizable para toda la página.
        Encapsula AllowDrop + DragEnter/DragOver/DragLeave/Drop, el overlay
        oscuro que aparece al arrastrar y el timer anti-parpadeo.
        El contenido que envuelve se aloja en el ContentPresenter y el overlay
        se dibuja encima de todo.
    -->
    <Grid AllowDrop="True"
          DragEnter="OnDragEnter"
          DragOver="OnDragOver"
          DragLeave="OnDragLeave"
          Drop="OnDrop">

        <ContentPresenter x:Name="HostPresenter"
                          Content="{x:Bind Host, Mode=OneWay}" />

        <!-- Overlay oscuro: oscurece la página y avisa que se suelte -->
        <Border x:Name="Overlay"
                Background="#66000000"
                CornerRadius="12"
                Visibility="Collapsed">
            <StackPanel Orientation="Vertical"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12">
                <Border x:Name="OverlayBadge"
                        Width="72" Height="72"
                        CornerRadius="36"
                        HorizontalAlignment="Center">
                    <ic:FluentIcon x:Name="OverlayIcon" Icon="FolderOpen" IconVariant="Regular" IconSize="Size32"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="CaptionLabel"
                           Text="{x:Bind Caption, Mode=OneWay}"
                           FontSize="20" FontWeight="SemiBold"
                           Foreground="White"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="SubtitleLabel"
                           Text="{x:Bind Subtitle, Mode=OneWay}"
                           FontSize="13"
                           Foreground="#D0FFFFFF"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           MaxWidth="480"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>