<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Remove_Top.Controls.FileSourceControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        Selección de origen reutilizable: carpeta (recursiva) o archivos sueltos,
        con botones "Carpeta..."/"Archivos...", pista de arrastre, botón
        "Limpiar" y tinte de color cuando hay archivos cargados. Cada página
        configura el filtro de archivos, la recursión, el tope y el color de
        acento, y consume la lista vía Files/StateChanged.
    -->
    <Border x:Name="SourceCard"
            BorderBrush="{ThemeResource ControlElevationBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="16"
            Background="{ThemeResource LayerFillColorDefaultBrush}">
        <StackPanel Spacing="12">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                <TextBlock Text="Origen"
                           FontSize="16" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1"
                           x:Name="BrandSiteText"
                           Text=""
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           Visibility="Collapsed" />
                <Button Grid.Column="2"
                        x:Name="ClearLoadedButton"
                        Content="Limpiar"
                        Click="ClearLoadedButton_Click"
                        Visibility="Collapsed"
                        CornerRadius="4"
                        Background="Transparent"
                        BorderThickness="1.5" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <TextBox x:Name="SourcePathBox"
                         PlaceholderText="Selecciona una carpeta o archivos..."
                         IsReadOnly="True"
                         CornerRadius="4" />
                <Button Grid.Column="1"
                        x:Name="BrowseFolderButton"
                        Content="Carpeta..."
                        Click="BrowseFolderButton_Click"
                        CornerRadius="4"
                        Background="Transparent"
                        BorderThickness="1.5" />
                <Button Grid.Column="2"
                        x:Name="BrowseFilesButton"
                        Content="Archivos..."
                        Click="BrowseFilesButton_Click"
                        CornerRadius="4"
                        Background="Transparent"
                        BorderThickness="1.5" />
            </Grid>
            <!-- Pista visual de arrastre (el destino real es toda la página) -->
            <Border x:Name="DropZone"
                    CornerRadius="4"
                    Padding="12">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Spacing="8">
                    <ic:FluentIcon x:Name="DropZoneIcon"
                                   Icon="Tag" IconVariant="Regular" IconSize="Size16"
                                   VerticalAlignment="Center" />
                    <TextBlock x:Name="DropZoneText"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"
                               TextAlignment="Center" />
                </StackPanel>
            </Border>
            <TextBlock x:Name="SourceStatusText"
                       FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap" />
        </StackPanel>
    </Border>
</UserControl>